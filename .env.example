# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
# Get this from: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel ID
