generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ColorFamily {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Tortoise", "Midnight Blue"
  hex       String   // Base color code (e.g., #123456)
  imageUrl  String?  // Optional pattern image for the family swatch
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id                  String                @id @default(cuid())
  name                String                @unique
  PrescriptionGlasses PrescriptionGlasses[]
  Product             Product[]
}

model Offer {
  id          String   @id @default(cuid())
  name        String
  discountPct Int?
  discountAmt Decimal?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  productId   String   @unique
  Product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id                        String                @id @default(cuid())
  name                      String
  slug                      String                @unique
  brand                     String                @default("FocusRobin")
  description               String?
  basePrice                 Decimal               @db.Decimal(10, 2)
  compareAtPrice            Decimal?              @db.Decimal(10, 2)
  calculatedRetailPrice     Decimal?              @db.Decimal(10, 2) // Pre-computed final price including margin
  status                    ProductStatus         @default(PUBLISHED)
  confidenceScore           Int?
  discountPct               Int?                  @default(0)
  cashbackAmount            Decimal?              @default(0) @db.Decimal(10, 2)
  gender                    Gender[]
  tags                      String[]
  frameWidth                Float
  lensWidth                 Float
  lensHeight                Float
  bridgeWidth               Float
  templeLength              Float
  weightBg                  Float
  frameMaterial             String
  lensMaterial              String?               @default("Polycarbonate")
  uvProtection              String
  glassShape                String?
  lensBaseImageUrl          String?
  lensMaskImageUrl          String?
  lensBackgroundImageUrl    String?
  averageRating             Float                 @default(0)
  reviewCount               Int                   @default(0)
  isNewlyAdded              Boolean               @default(false)
  isUniqueDesign            Boolean               @default(false)
  isPolarized               Boolean               @default(false)
  isUVProtection            Boolean               @default(false)
  isHydrophobic             Boolean               @default(false)
  isAntiScratch             Boolean               @default(false)
  isBioBased                Boolean               @default(false)
  showHighlights            Boolean               @default(false)
  warranty                  String                @default("2 Years Warranty")
  customFeatures            String[]              @default([])
  categoryId                String
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  CartItem                  CartItem[]
  Offer                     Offer?
  OrderItems                OrderItem[]
  LinkedPrescriptionGlasses PrescriptionGlasses[] @relation("PrescriptionGlassesLinkedProduct")
  Category                  Category              @relation(fields: [categoryId], references: [id])
  highlights                ProductHighlight[]
  ProductVariant            ProductVariant[]
  Review                    Review[]
  Wishlist                  Wishlist[]
  PriceHistory              PriceHistory[]

  @@index([brand])
  @@index([glassShape])
  @@index([frameMaterial])
  @@index([isNewlyAdded])
  @@index([isUniqueDesign])
  @@index([calculatedRetailPrice])
}

model PrescriptionGlasses {
  id                         String                       @id @default(cuid())
  name                       String
  slug                       String                       @unique
  brand                      String                       @default("FocusRobin")
  description                String?
  basePrice                  Decimal                      @db.Decimal(10, 2)
  compareAtPrice             Decimal?                     @db.Decimal(10, 2)
  calculatedRetailPrice      Decimal?                     @db.Decimal(10, 2) // Pre-computed final price including margin
  status                     ProductStatus                @default(PUBLISHED)
  confidenceScore            Int?
  discountPct                Int?                         @default(0)
  cashbackAmount             Decimal?                     @default(0) @db.Decimal(10, 2)
  linkedProductId            String?
  useSharedStock             Boolean                      @default(false)
  gender                     Gender[]
  tags                       String[]
  frameWidth                 Float
  lensWidth                  Float
  lensHeight                 Float
  bridgeWidth                Float
  templeLength               Float
  weightBg                   Float
  frameMaterial              String
  lensMaterial               String?                      @default("Polycarbonate")
  uvProtection               String?
  glassShape                 String?
  averageRating              Float                        @default(0)
  reviewCount                Int                          @default(0)
  isNewlyAdded               Boolean                      @default(false)
  isUniqueDesign             Boolean                      @default(false)
  isPolarized                Boolean                      @default(false)
  isUVProtection             Boolean                      @default(false)
  isHydrophobic              Boolean                      @default(false)
  isAntiScratch              Boolean                      @default(false)
  isBioBased                 Boolean                      @default(false)
  showHighlights             Boolean                      @default(false)
  warranty                   String                       @default("1.5 Years Warranty")
  customFeatures             String[]                     @default([])
  categoryId                 String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  Category                   Category                     @relation(fields: [categoryId], references: [id])
  LinkedProduct              Product?                     @relation("PrescriptionGlassesLinkedProduct", fields: [linkedProductId], references: [id])
  PrescriptionGlassesOffer   PrescriptionGlassesOffer?
  PrescriptionGlassesVariant PrescriptionGlassesVariant[]
  highlights                 PrescriptionHighlight[]
  CartItem                   CartItem[]
  Wishlist                   Wishlist[]
  OrderItems                 OrderItem[]

  @@index([brand])
  @@index([glassShape])
  @@index([frameMaterial])
  @@index([isNewlyAdded])
  @@index([calculatedRetailPrice])
}

model PrescriptionHighlight {
  id                    String              @id @default(cuid())
  prescriptionGlassesId String
  title                 String
  description           String
  imageUrl              String
  order                 Int                 @default(0)
  createdAt             DateTime            @default(now())
  PrescriptionGlasses   PrescriptionGlasses @relation(fields: [prescriptionGlassesId], references: [id], onDelete: Cascade)
}

model PrescriptionGlassesVariant {
  id                       String                     @id @default(cuid())
  prescriptionGlassesId    String
  name                     String
  sku                      String                     @unique
  colorName                String
  colorHex                 String
  colorFamily              String? // Broad category for filtering (e.g., "Blue", "Tortoise")
  textureImageUrl          String? // URL for texture swatch image
  lensColor                String
  stock                    Int                        @default(0)
  price                    Decimal?                   @db.Decimal(10, 2)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  PrescriptionGlassesAsset PrescriptionGlassesAsset[]
  PrescriptionGlasses      PrescriptionGlasses        @relation(fields: [prescriptionGlassesId], references: [id], onDelete: Cascade)
}

model PrescriptionGlassesAsset {
  id        String                     @id @default(cuid())
  variantId String
  url       String
  type      AssetType
  isPrimary Boolean                    @default(false)
  createdAt DateTime                   @default(now())
  Variant   PrescriptionGlassesVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model PrescriptionGlassesOffer {
  id                    String              @id @default(cuid())
  name                  String
  discountPct           Int?
  discountAmt           Decimal?
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean             @default(true)
  prescriptionGlassesId String              @unique
  PrescriptionGlasses   PrescriptionGlasses @relation(fields: [prescriptionGlassesId], references: [id], onDelete: Cascade)
}

model ProductAsset {
  id             String         @id @default(cuid())
  variantId      String
  url            String
  type           AssetType
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  ProductVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  name         String
  sku          String         @unique
  colorName    String
  colorHex     String
  colorFamily  String? // Broad category for filtering (e.g., "Blue", "Tortoise")
  textureImageUrl String? // URL for texture swatch image
  lensColor    String
  stock        Int            @default(0)
  price        Decimal?       @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ProductAsset ProductAsset[]
  Product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductHighlight {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String
  imageUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String
  comment   String
  images    String[]
  productId String?
  orderId   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order?   @relation(fields: [orderId], references: [id])
  Product   Product? @relation(fields: [productId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
  @@index([userId])
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  role          String            @default("USER")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accounts      Account[]
  addresses     Address[]
  cart          Cart?
  chats         Chat[]
  orders        Order[]
  Review        Review[]
  sessions      Session[]
  prescriptions UserPrescription?
  wallet        Wallet?
  wishlist      Wishlist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id                    String               @id @default(cuid())
  cartId                String
  productId             String?
  prescriptionGlassesId String?
  variantId             String
  quantity              Int                  @default(1)
  prescriptionData      Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  Cart                  Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product               Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  PrescriptionGlasses   PrescriptionGlasses? @relation(fields: [prescriptionGlassesId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id                    String               @id @default(cuid())
  userId                String
  productId             String?
  prescriptionGlassesId String?
  createdAt             DateTime             @default(now())
  Product               Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  PrescriptionGlasses   PrescriptionGlasses? @relation(fields: [prescriptionGlassesId], references: [id], onDelete: Cascade)
  User                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, productId])
  @@index([userId, prescriptionGlassesId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  User         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String
  createdAt   DateTime        @default(now())
  Wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("Ireland")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPrescription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  odSph                 String
  odCyl                 String
  odAxis                String
  osSph                 String
  osCyl                 String
  osAxis                String
  pd                    String
  pdOd                  String?
  pdOs                  String?
  hasTwoPDs             Boolean  @default(false)
  hasPrism              Boolean  @default(false)
  odPrismHorizontal     String?
  odPrismHorizontalBase String?
  odPrismVertical       String?
  odPrismVerticalBase   String?
  osPrismHorizontal     String?
  osPrismHorizontalBase String?
  osPrismVertical       String?
  osPrismVerticalBase   String?
  prescriptionImageUrl  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  User                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeletedUser {
  id             String    @id @default(cuid())
  originalUserId String    @unique
  email          String
  name           String?
  image          String?
  role           String
  emailVerified  DateTime?
  createdAt      DateTime
  deletedAt      DateTime  @default(now())
  userData       Json
  accountsData   Json
  sessionsData   Json
  cartData       Json?
  wishlistData   Json
  walletData     Json?
  reviewsData    Json
  addressesData  Json
}

model HeroImage {
  id              String   @id @default(cuid())
  desktopImageUrl String
  mobileImageUrl  String
  title           String
  subtitle        String
  ctaText         String
  ctaLink         String
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InstagramImage {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  link      String   @default("https://www.instagram.com/p/DQwrNF9ikKg/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryImage {
  id                   String   @id @default(cuid())
  category             String   @unique
  imageUrl             String
  mobileTabletImageUrl String?
  alt                  String
  link                 String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model IconicImage {
  id                   String   @id @default(cuid())
  imageUrl             String
  mobileTabletImageUrl String?
  alt                  String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PrescriptionGlassesLandingImage {
  id                   String   @id @default(cuid())
  imageUrl             String
  mobileTabletImageUrl String?
  alt                  String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GiftBanner {
  id                   String   @id @default(cuid())
  imageUrl             String
  mobileTabletImageUrl String?
  title                String
  subtitle             String?
  link                 String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GiftForLovedOnesBanner {
  id                   String   @id @default(cuid())
  imageUrl             String
  mobileTabletImageUrl String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ScrollingBanner {
  id        String   @id @default(cuid())
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopBanner {
  id        String   @id @default(cuid())
  category  String   @unique
  imageUrl  String
  alt       String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrescriptionShopBanner {
  id        String   @id @default(cuid())
  category  String   @unique
  imageUrl  String
  alt       String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavbarSettings {
  id                   String   @id @default(cuid())
  iconColorNotScrolled String   @default("white")
  logoColorNotScrolled String   @default("white")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Chat {
  id            String        @id @default(cuid())
  userId        String?
  userEmail     String
  userName      String?
  userLanguage  String        @default("en")
  status        ChatStatus    @default(OPEN)
  forceClosed   Boolean       @default(false)
  forceClosedAt DateTime?
  forceClosedBy String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime      @default(now())
  User          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([userEmail])
}

model UserBlock {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  blockedUntil DateTime
  reason       String?
  blockedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userEmail])
  @@index([blockedUntil])
}

model ChatMessage {
  id             String        @id @default(cuid())
  chatId         String
  sender         MessageSender
  originalText   String
  translatedText String
  language       String
  createdAt      DateTime      @default(now())
  Chat           Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([read])
  @@index([createdAt])
}

model Order {
  id                    String        @id @default(cuid())
  userId                String
  orderNumber           String        @unique
  status                OrderStatus   @default(PENDING)
  paymentMethod         String
  paymentStatus         PaymentStatus @default(PENDING)
  subtotal              Decimal       @db.Decimal(10, 2)
  shipping              Decimal       @default(0) @db.Decimal(10, 2)
  total                 Decimal       @db.Decimal(10, 2)
  currency              String        @default("EUR")
  walletAmountUsed      Decimal       @default(0) @db.Decimal(10, 2)
  promoCodeId           String?
  promoDiscount         Decimal       @default(0) @db.Decimal(10, 2)
  promoCashback         Decimal       @default(0) @db.Decimal(10, 2)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  isPaid                Boolean       @default(false)
  paypalOrderId         String?       @unique
  paypalCaptureId       String?
  shippingProvider      String        @default("DHL")
  trackingNumber        String?
  trackingMessage       String?
  shippingName          String
  shippingPhone         String
  shippingAddressLine1  String
  shippingAddressLine2  String?
  shippingCity          String
  shippingState         String?
  shippingPostalCode    String
  shippingCountry       String        @default("Ireland")
  billingName           String?
  billingPhone          String?
  billingAddressLine1   String?
  billingAddressLine2   String?
  billingCity           String?
  billingState          String?
  billingPostalCode     String?
  billingCountry        String?
  isBusinessPurchase    Boolean       @default(false)
  businessName          String?
  businessNumber        String?
  vatNumber             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  shippedAt             DateTime?
  deliveredAt           DateTime?
  PromoCode             PromoCode?    @relation(fields: [promoCodeId], references: [id])
  User                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  Review                Review[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                    String               @id @default(cuid())
  orderId               String
  productId             String?
  prescriptionGlassesId String?
  variantId             String
  productName           String
  variantName           String
  sku                   String
  quantity              Int
  price                 Decimal              @db.Decimal(10, 2)
  total                 Decimal              @db.Decimal(10, 2)
  imageUrl              String?
  prescriptionData      Json?
  createdAt             DateTime             @default(now())
  Order                 Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product               Product?             @relation(fields: [productId], references: [id])
  PrescriptionGlasses   PrescriptionGlasses? @relation(fields: [prescriptionGlassesId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([prescriptionGlassesId])
}

model CurrencyRate {
  id          String   @id @default(cuid())
  code        String   @unique
  rate        Float
  symbol      String
  name        String
  lastUpdated DateTime @default(now()) @updatedAt

  @@index([code])
}

model NewsletterSubscription {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@index([email])
  @@index([isActive])
}

model PromoCode {
  id                          String    @id @default(cuid())
  code                        String    @unique
  description                 String?
  discountPercentage          Decimal?  @db.Decimal(5, 2)
  discountAmount              Decimal?  @db.Decimal(10, 2)
  cashbackPercentage          Decimal?  @db.Decimal(5, 2)
  isActive                    Boolean   @default(true)
  startDate                   DateTime  @default(now())
  endDate                     DateTime?
  usageLimit                  Int?
  usedCount                   Int       @default(0)
  minPurchaseAmount           Decimal?  @db.Decimal(10, 2)
  minFrameQuantity            Int?
  bulkFrameDiscountPercentage Decimal?  @db.Decimal(5, 2)
  applyToFramesOnly           Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  Order                       Order[]

  @@index([code])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model GlassShape {
  id              String   @id @default(cuid())
  name            String   @unique
  imageUrl        String?
  landingImageUrl String?
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@index([order])
}

model Brand {
  id              String   @id @default(cuid())
  name            String   @unique
  imageUrl        String?
  landingImageUrl String?
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@index([order])
}

model PrescriptionLensImage {
  id                String   @id @default(cuid())
  lensType          String?
  lensIndex         String?
  coating           String?
  tintType          String?
  tintColor         String?
  tintShadePercent  Int?
  tintRecipe        String?
  photochromicColor String?
  polarizedColor    String?
  frameType         String?
  imageUrl          String
  isOutdoor         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lensType])
  @@index([lensType, isOutdoor])
  @@index([lensType, coating, isOutdoor])
}

model PrescriptionLensPrice {
  id        String   @id @default(cuid())
  lensType  String
  lensIndex String
  coating   String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lensType, lensIndex, coating])
  @@index([lensType])
  @@index([lensType, lensIndex])
}

model PrescriptionTintFee {
  id        String   @id @default(cuid())
  tintType  String   @unique
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrescriptionEdgingFee {
  id        String   @id @default(cuid())
  frameType String   @unique
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrescriptionProfit {
  id        String   @id @default(cuid())
  profit    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @unique @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SplitBanner {
  id              String   @id @default(cuid())
  sectionKey      String   @unique
  title           String
  leftImageUrl    String
  leftLink        String
  leftButtonText  String
  rightImageUrl   String
  rightLink       String
  rightButtonText String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LensBundlePrice {
  id        String   @id @default(cuid())
  bundleId  String   @unique
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  sku         String
  oldPrice    Decimal  @db.Decimal(10, 2)
  newPrice    Decimal  @db.Decimal(10, 2)
  changedAt   DateTime @default(now())
  source      String   @default("bigbuy-sync")

  Product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([changedAt])
  @@index([sku])
}

